# MCP Server 對外發布的埠號
PORT=8091

# ComfyUI 服務位址（請依實際佈署的主機與 Port 修改）
# 若在同一台機器以 Docker 執行，可用 http://host.docker.internal:8188
COMFYUI_URL=http://host.docker.internal:8188

# 宿主機上 ComfyUI 的模型與輸出目錄（供 download_model 與輸出讀取使用）
COMFYUI_MODELS_DIR=/data/comfyui/models
COMFYUI_OUTPUT_DIR=/data/comfyui/output

# 選填：與宿主機共用的 Workflow 暫存目錄（若使用 validate_workflow_json / run_workflow_json 則不需依賴此目錄）
WORKFLOW_HOST_DIR=./tmp
